# LLM providers — JSON array, first entry = primary, fallback in order on failure
# Each provider must expose an OpenAI-compatible chat completions API
# 示例：[{"name":"kimi","baseUrl":"https://api.moonshot.cn/v1","apiKey":"sk-xxx","model":"moonshot-v1-32k"}]
LLM_PROVIDERS=

# TTS — Murf API key (get from murf.ai)
MURF_API_KEY=

# External question bank (optional) — leave empty to disable
# Must support GET ?q=<text>&type=keyword|semantic
# QUESTION_SEARCH_URL=https://interview-crawler-production.up.railway.app/api/questions/search

PORT=3001
